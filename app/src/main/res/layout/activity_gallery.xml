<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="24dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical">

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="Captures"
            android:textSize="28sp"
            android:textStyle="bold" />

        <Button
            android:id="@+id/galleryRestore"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Restore wallpaper"
            android:textSize="13sp" />

        <Button
            android:id="@+id/galleryBack"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:backgroundTint="#33FFFFFF"
            android:text="Close"
            android:textSize="13sp" />
    </LinearLayout>

    <TextView
        android:id="@+id/galleryStorage"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:textSize="12sp"
        android:textColor="#80FFFFFF"
        android:text="" />

    <TextView
        android:id="@+id/galleryEmpty"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="40dp"
        android:gravity="center"
        android:text="No captures yet.\n\nWhen someone who isn't you triggers a check, everything they captured shows up here."
        android:textSize="15sp"
        android:textColor="#80FFFFFF"
        android:visibility="gone" />

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:layout_marginTop="12dp">

        <LinearLayout
            android:id="@+id/sessionList"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical" />
    </ScrollView>

</LinearLayout>
