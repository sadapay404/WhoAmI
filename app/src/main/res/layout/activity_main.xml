<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="28dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/app_name"
            android:textSize="34sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/homeStatus"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:textSize="15sp"
            android:textColor="#B3FFFFFF"
            android:text="" />

        <!-- Status card -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:orientation="vertical"
            android:padding="20dp"
            android:background="#14FFFFFF">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="STATUS"
                android:textSize="12sp"
                android:letterSpacing="0.15"
                android:textColor="#E94560"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/statusLine"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:textSize="15sp"
                android:lineSpacingMultiplier="1.5"
                android:text="" />

            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:layout_marginVertical="12dp"
                android:background="#1AFFFFFF" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="HEALTH (long-press for battery help)"
                android:textSize="12sp"
                android:letterSpacing="0.15"
                android:textColor="#E94560"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/healthLine"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:textSize="14sp"
                android:lineSpacingMultiplier="1.5"
                android:text="" />

            <LinearLayout
                android:id="@+id/fixContainer"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:orientation="vertical" />
        </LinearLayout>

        <!-- Threshold tuning -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:padding="14dp"
            android:background="#14FFFFFF">

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="Face-match threshold\nhigher = fewer false alarms"
                android:textSize="14sp"
                android:lineSpacingMultiplier="1.3" />

            <Button
                android:id="@+id/btnThresholdDown"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:minWidth="0dp"
                android:minHeight="0dp"
                android:text="−"
                android:textSize="20sp" />

            <TextView
                android:id="@+id/thresholdValue"
                android:layout_width="56dp"
                android:layout_height="wrap_content"
                android:gravity="center"
                android:fontFamily="monospace"
                android:textSize="18sp"
                android:textStyle="bold"
                android:text="0.55" />

            <Button
                android:id="@+id/btnThresholdUp"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:minWidth="0dp"
                android:minHeight="0dp"
                android:text="+"
                android:textSize="20sp" />
        </LinearLayout>

        <!-- Settings -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:orientation="vertical"
            android:padding="16dp"
            android:background="#14FFFFFF">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="SETTINGS"
                android:textSize="12sp"
                android:letterSpacing="0.15"
                android:textColor="#E94560"
                android:textStyle="bold" />

            <com.google.android.material.materialswitch.MaterialSwitch
                android:id="@+id/switchWhatsapp"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text="Check face when WhatsApp opens"
                android:textSize="14sp" />

            <com.google.android.material.materialswitch.MaterialSwitch
                android:id="@+id/switchUncertain"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Capture even when face is unclear (strict)"
                android:textSize="14sp" />

            <com.google.android.material.materialswitch.MaterialSwitch
                android:id="@+id/switchArmed"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Protection armed"
                android:textSize="14sp" />
        </LinearLayout>

        <Button
            android:id="@+id/btnTestCheck"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:text="Test face check"
            android:textSize="16sp" />

        <Button
            android:id="@+id/btnReenroll"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:backgroundTint="#33FFFFFF"
            android:text="Re-enroll face"
            android:textSize="15sp" />

        <Button
            android:id="@+id/btnResetwork"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:backgroundTint="#33FFFFFF"
            android:text="Re-save wallpaper"
            android:textSize="15sp" />

        <Button
            android:id="@+id/btnSimulate"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:backgroundTint="#33E94560"
            android:text="⚠ Simulate intruder (test capture)"
            android:textSize="15sp" />

        <Button
            android:id="@+id/btnViewCaptures"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:backgroundTint="#33FFFFFF"
            android:text="View captured sessions"
            android:textSize="15sp" />

        <!-- Decision log -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:orientation="vertical"
            android:padding="16dp"
            android:background="#14FFFFFF">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal">

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="RECENT CHECKS"
                    android:textSize="12sp"
                    android:letterSpacing="0.15"
                    android:textColor="#E94560"
                    android:textStyle="bold" />

                <Button
                    android:id="@+id/btnClearLog"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:minHeight="0dp"
                    android:minWidth="0dp"
                    android:padding="4dp"
                    android:backgroundTint="#00000000"
                    android:text="Clear"
                    android:textSize="12sp"
                    android:textColor="#80FFFFFF" />
            </LinearLayout>

            <TextView
                android:id="@+id/logView"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:fontFamily="monospace"
                android:textSize="11sp"
                android:lineSpacingMultiplier="1.4"
                android:text="No checks yet"
                android:maxLines="14"
                android:ellipsize="start" />
        </LinearLayout>

        <TextView
            android:id="@+id/homeNote"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:textSize="13sp"
            android:textColor="#80FFFFFF"
            android:lineSpacingMultiplier="1.4"
            android:text="" />

    </LinearLayout>
</ScrollView>
